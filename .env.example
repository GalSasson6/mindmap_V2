# Gemini API key(s). Comma-separate several keys to rotate between them when one runs out of quota.
GEMINI_API_KEYS=your-key-1,your-key-2

# Optional: default model (falls back to gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: extra hosts allowed to open the dev server, e.g. your LAN or Tailscale address
# ALLOWED_DEV_ORIGINS=192.168.1.20,my-machine.example.ts.net
